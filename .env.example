# Copy this file to .env and fill in your keys. .env is git-ignored - never commit it.

# --- LLM: OpenAI models through OpenRouter (one key, OpenAI-compatible API) ---
OPENROUTER_API_KEY=
# The model that writes the final answer (quality matters most here).
LLM_MODEL=openai/gpt-5.6-sol
# A ~20x cheaper model for the many small jobs: tool call, MQE / HyDE,
# reflection and the RAGAS / DeepEval judges.
FAST_LLM_MODEL=openai/gpt-6-luna

# --- Embeddings ---
# openrouter = OpenAI text-embedding-3-small through OpenRouter: 1536 dimensions, ~$0.02 per million tokens.
# local      = MiniLM on this computer: 384 dimensions, free (then use a 384-dimension Pinecone index).
EMBEDDING_BACKEND=openrouter

# --- Vector database: Pinecone (the only store - there is no local database) ---
# The index must have the same number of dimensions as the embeddings (1536 for openrouter).
# Data lives in its own namespace, so other data in the same index is never touched.
PINECONE_API_KEY=
PINECONE_INDEX=retrieval-lab-dense
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
PINECONE_NAMESPACE=knowledge-base

# --- LangSmith tracing (optional) ---
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=rag-learning-visualiser

# --- Big-file safety (optional, these are the defaults) ---
# MAX_UPLOAD_MB=60            uploads bigger than this are refused
# MAX_INGEST_CHARS=200000     only this many characters of one file are ingested (~500 chunks)

# --- Retrieval / chunking knobs (optional, these are the defaults) ---
# CHUNK_STRATEGY=recursive
# CHUNK_SIZE=400
# CHUNK_OVERLAP=60
# SEARCH_K=20
# POST_FILTER_MAX=8
# MIN_RELEVANCE=0.20
# RERANK_TOP_N=4
